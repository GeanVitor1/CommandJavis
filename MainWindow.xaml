<Window x:Class="Vox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vox"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Vox"
        Width="1280" Height="820"
        MinWidth="1000" MinHeight="680"
        WindowStyle="None"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13.5"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Window.Resources>
        <DataTemplate x:Key="CommandCardTemplate">
            <Border Style="{StaticResource CommandCard}" PreviewMouseLeftButtonDown="Card_MouseLeftButtonDown"
                    Focusable="True" KeyDown="Card_KeyDown" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Grid Margin="16,13">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <local:AppIconControl Grid.Column="0"
                                          Icon="{Binding Icon}" HasIcon="{Binding HasIcon}"
                                          AvatarChar="{Binding AvatarChar}" Category="{Binding Category}"
                                          Size="36" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Description}" FontSize="14.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" TextOptions.TextFormattingMode="Ideal"/>
                        <TextBlock Text="{Binding Target}" FontSize="12.5" Foreground="{DynamicResource TextTertiaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,12,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                        <ItemsControl ItemsSource="{Binding ComboParts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Keycap}" Margin="3,0,0,0">
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI, Segoe UI Variable Text"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Sem atalho" Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" FontSize="11">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasCombo}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource RowActionButton}" Content="Abrir" Click="Run_Click"/>
                        <Button Style="{StaticResource RowActionButton}" Content="Editar" Click="Edit_Click"/>
                        <Button Style="{StaticResource RowDangerButton}" Content="Excluir" Click="Remove_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="TypeCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="13,10" Margin="0,0,8,0" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StepHeader" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="StepNumber" TargetType="Border">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StepHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Barra de título — editorial, 42px max, single line ===== -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" SnapsToDevicePixels="True">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="21" Height="21" CornerRadius="6" Background="{DynamicResource AccentBrush}" SnapsToDevicePixels="True">
                            <TextBlock Text="V" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <TextBlock Text="Vox" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/>
                        <TextBlock Text="•" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7"/>
                        <TextBlock Text="assistente local" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <!-- Navegação interna — single line, 64px cap -->
                        <StackPanel x:Name="NavBar" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                            <RadioButton x:Name="NavHome" Style="{StaticResource TabPill}" Content="Início" IsChecked="True" Checked="NavHome_Checked"/>
                            <RadioButton x:Name="NavHistory" Style="{StaticResource TabPill}" Content="Histórico" Checked="NavHistory_Checked"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource TabPill}" Content="Configurações" Checked="NavSettings_Checked"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizar"/>
                        <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Fechar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Host de Views ===== -->
            <Grid Grid.Row="1" ClipToBounds="True">
                <!-- VIEW: Lista -->
                <Grid x:Name="ListViewRoot" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="32,22,32,18">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Seus atalhos" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextOptions.TextFormattingMode="Ideal"/>
                            <TextBlock Text="Pressione a combinação em qualquer lugar do Windows" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,5,0,0" Opacity="0.95"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="11,6" SnapsToDevicePixels="True">
                                <TextBlock x:Name="StatsText" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="Medium"/>
                            </Border>
                            <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="Add_Click" Padding="16,8">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="+" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/><TextBlock Text="Novo comando" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" Margin="32,0,32,16">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="3" HorizontalAlignment="Left" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AppTabRadio" Style="{StaticResource TabPill}" Content="Aplicativos" IsChecked="True" Checked="Tab_Checked"/>
                                <RadioButton x:Name="SiteTabRadio" Style="{StaticResource TabPill}" Content="Sites" Checked="Tab_Checked"/>
                            </StackPanel>
                        </Border>
                        <Grid Width="260" HorizontalAlignment="Right">
                            <local:WatermarkTextBox x:Name="SearchBox" Placeholder="Buscar comando…" TextChanged="Search_TextChanged"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="2" Margin="32,0,32,14">
                        <ListBox x:Name="AppList" ItemTemplate="{StaticResource CommandCardTemplate}" ItemContainerStyle="{StaticResource ListCardItem}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" KeyboardNavigation.DirectionalNavigation="Contained"/>
                        <!-- Empty states — editorial, composed, not plain text -->
                        <StackPanel x:Name="EmptyApp" HorizontalAlignment="Center" Margin="0,48,0,0">
                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8FC;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nenhum aplicativo por aqui" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,0"/>
                            <TextBlock Text="Clique em “Novo comando” para adicionar seu primeiro atalho." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                            <Button Style="{StaticResource GhostButton}" Content="Criar comando" Margin="0,16,0,0" HorizontalAlignment="Center" Padding="16,7" Click="Add_Click"/>
                        </StackPanel>
                        <StackPanel x:Name="EmptySite" HorizontalAlignment="Center" Margin="0,48,0,0">
                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nenhum site por aqui" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,0"/>
                            <TextBlock Text="Seus sites favoritos aparecerão aqui." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="EmptySearch" HorizontalAlignment="Center" Margin="0,48,0,0">
                            <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Nenhum resultado" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,0"/>
                            <TextBlock x:Name="EmptySearchText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- VIEW: Novo comando — mockup “Adicionar aplicativo” -->
                <Grid x:Name="AddViewRoot" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="32,20,32,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Padding="10,8" Click="BackToList_Click" VerticalAlignment="Top" ToolTip="Voltar">
                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="AddTitleText" Text="Adicionar aplicativo" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextOptions.TextFormattingMode="Ideal"/>
                            <TextBlock Text="Crie um comando para abrir sites, programas ou executar ações." FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="32,18,32,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="StepCircle1" Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <TextBlock Text="1" FontWeight="SemiBold" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StepLabel1" Text="Nome" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Height="1.5" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="10,0" Opacity="0.6"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.9">
                            <Border x:Name="StepCircle2" Width="22" Height="22" CornerRadius="11" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <TextBlock Text="2" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StepLabel2" Text="Tipo" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="3" Height="1.5" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="10,0" Opacity="0.5"/>
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.9">
                            <Border x:Name="StepCircle3" Width="22" Height="22" CornerRadius="11" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <TextBlock Text="3" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StepLabel3" Text="Destino" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="5" Height="1.5" Background="{DynamicResource BorderBrush}" VerticalAlignment="Center" Margin="10,0" Opacity="0.5"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.9">
                            <Border x:Name="StepCircle4" Width="22" Height="22" CornerRadius="11" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <TextBlock Text="4" FontWeight="Medium" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="StepLabel4" Text="Atalho" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                        <Grid Margin="32,0,32,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0" SnapsToDevicePixels="True">
                                <StackPanel>
                                    <StackPanel Style="{StaticResource StepHeader}" Margin="0,0,0,8">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}" SnapsToDevicePixels="True">
                                            <TextBlock Text="1" FontWeight="SemiBold" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource StepLabel}" Text="Nome do comando" FontSize="12.5"/>
                                    </StackPanel>
                                    <Grid>
                                        <local:WatermarkTextBox x:Name="DescriptionBox"/>
                                        <TextBlock Text="&#xE7B5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False" Opacity="0.85"/>
                                    </Grid>
                                    <TextBlock x:Name="NameError" Text="Digite um nome para o comando." FontSize="11" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                    <TextBlock Text="Use um nome claro, ex: “Abrir YouTube”" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,6,0,0" Opacity="0.9"/>

                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,18,0,18"/>

                                    <StackPanel Style="{StaticResource StepHeader}">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}" SnapsToDevicePixels="True">
                                            <TextBlock Text="2" FontWeight="SemiBold" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource StepLabel}" Text="Tipo" FontSize="12.5"/>
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="UrlType" Grid.Column="0" Style="{StaticResource TypeCard}" Margin="0,0,8,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                                        <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Site" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="Abre uma página" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"/>
                                                        <TextBlock Text="na web" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border x:Name="CheckUrl" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Visibility="Collapsed" SnapsToDevicePixels="True" BorderBrush="White" BorderThickness="1.5">
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="7.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </RadioButton>
                                        <RadioButton x:Name="OpenType" Grid.Column="1" Style="{StaticResource TypeCard}" Margin="0,0,8,0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                                        <TextBlock Text="&#xE8FC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Aplicativo" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="Abre um programa" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"/>
                                                        <TextBlock Text="instalado" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border x:Name="CheckApp" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Visibility="Visible" SnapsToDevicePixels="True" BorderBrush="White" BorderThickness="1.5">
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="7.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </RadioButton>
                                        <RadioButton x:Name="CommandType" Grid.Column="2" Style="{StaticResource TypeCard}" Margin="0">
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="32" Height="32" CornerRadius="16" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                                                        <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="Comando" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="Executa uma ação" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"/>
                                                        <TextBlock Text="no terminal" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Border x:Name="CheckCmd" Width="16" Height="16" CornerRadius="8" Background="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Visibility="Collapsed" SnapsToDevicePixels="True" BorderBrush="White" BorderThickness="1.5">
                                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="7.5" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </RadioButton>
                                    </Grid>
                                    <TextBlock Style="{StaticResource StepHint}" Text="Escolha o que este comando irá abrir ou executar." Margin="0,8,0,0"/>

                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,18,0,18"/>

                                    <StackPanel Style="{StaticResource StepHeader}">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}" SnapsToDevicePixels="True">
                                            <TextBlock Text="3" FontWeight="SemiBold" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource StepLabel}" Text="Destino" FontSize="12.5"/>
                                    </StackPanel>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <local:WatermarkTextBox x:Name="TargetBox"/>
                                        <Button x:Name="PickAppButton" Grid.Column="1" Style="{StaticResource GhostButton}" Padding="12,7" Margin="10,0,0,0" VerticalAlignment="Center" Click="PickAppInline_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock Text="Escolher aplicativo" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBlock x:Name="TargetError" Text="Digite um link, caminho ou escolha um app" FontSize="11" Foreground="{DynamicResource DangerBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                    <TextBlock Style="{StaticResource StepHint}" Text="Cole um link, digite o caminho de um programa ou clique no botão acima."/>

                                    <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.45" Margin="0,18,0,18"/>

                                    <StackPanel Style="{StaticResource StepHeader}">
                                        <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource AccentBrush}" SnapsToDevicePixels="True">
                                            <TextBlock Text="4" FontWeight="SemiBold" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Style="{StaticResource StepLabel}" Text="Atalho do teclado" FontSize="12.5"/>
                                        <Border Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="7,3" Margin="8,0,0,0" SnapsToDevicePixels="True">
                                            <TextBlock Text="opcional" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" FontWeight="Medium"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="HotkeyButton" Style="{StaticResource GhostButton}" Padding="13,7" Click="DefineHotkeyInline_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="HotkeyButtonText" Text="Definir teclas" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <ItemsControl x:Name="KeycapDisplay" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Keycap}" Margin="3,0,0,0"><TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="NoHotkeyText" Text="Sem atalho" Foreground="{DynamicResource TextTertiaryBrush}" FontStyle="Italic" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CaptureHint" Style="{StaticResource StepHint}" Visibility="Collapsed" Text="Pressione a combinação desejada (ex: Ctrl+Alt+S) ou Esc para cancelar" Foreground="{DynamicResource FocusRingBrush}"/>
                                    <TextBlock x:Name="HotkeyHint" Style="{StaticResource StepHint}" Text="Você também pode usar o comando apenas por voz." Foreground="{DynamicResource TextTertiaryBrush}"/>
</StackPanel>
                            </Border>

                            <StackPanel x:Name="InlinePreviewContainer" Visibility="Collapsed" Grid.Column="1" Margin="14,0,0,0" Width="340">
                                <Border x:Name="InlinePreviewPanel" Visibility="Visible" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="18" SnapsToDevicePixels="True">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.08" Color="#000000"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBlock Text="PRÉ-VISUALIZAÇÃO" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextTertiaryBrush}" Opacity="0.9"/>
                                        <Border Margin="0,14,0,0" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="11" SnapsToDevicePixels="True">
                                            <StackPanel>
                                                <Grid Margin="14,14,14,14">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <local:AppIconControl x:Name="PreviewIcon" Category="app" Size="44" AvatarChar="?" HasIcon="False" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="PreviewName" Text="Abrir Spotify" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <TextBlock x:Name="PreviewTypeText" Text="Aplicativo" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Text=" • " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0"/>
                                                            <TextBlock x:Name="PreviewStatusText" Text="Pronto para usar" FontSize="11.5" Foreground="#8B7CF7"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>
                                                <TextBlock x:Name="PreviewTarget" Visibility="Collapsed" Text="Destino do comando"/>
                                                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.6"/>
                                                <Grid Margin="14,10,14,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                                                        <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock x:Name="PreviewHotkeyLabel" Grid.Column="1" Text="Sem atalho" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                                    <ItemsControl x:Name="PreviewKeycap" Grid.Column="2" VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Keycap}" Margin="2,0,0,0" Padding="6,2"><TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="10.5" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <Border Grid.Row="3" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12" SnapsToDevicePixels="True">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ReadyText" Text="Preencha o nome e o destino para continuar" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource GhostButton}" Content="Cancelar" Padding="16,8" Click="AddCancel_Click"/>
                                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Padding="18,9" Click="ConfirmAdd_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Adicionar comando" Margin="7,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- VIEW: Configurações -->
                <ScrollViewer x:Name="SettingsViewRoot" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,18,24,16">
                    <StackPanel MaxWidth="640">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Style="{StaticResource GhostButton}" Padding="10,6" Click="BackToList_Click">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="Voltar" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                            </Button>
                            <TextBlock Text="Configurações" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextOptions.TextFormattingMode="Ideal"/>
                        </StackPanel>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Assistente de voz" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Reconhecimento offline, do jeito Vox" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/></StackPanel>
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5" Margin="0,14,0,14"/>
                                <CheckBox x:Name="EnableVoiceCheck" Content="Habilitar comando de voz" Checked="EnableVoice_Changed" Unchecked="EnableVoice_Changed"/>
                                <CheckBox x:Name="WakeWordCheck" Content="Ouvir sempre — diga “Ei Vox” para chamar" Margin="0,10,0,0" ToolTip="Fica escutando em segundo plano; ao ouvir “Ei Vox”, ele abre a captura de voz."/>
                                <CheckBox x:Name="AutoStartCheck" Content="Iniciar com o Windows" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Segure para falar" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Tecla global — funciona de qualquer lugar" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/></StackPanel>
                                </StackPanel>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource KeycapLarge}" VerticalAlignment="Center"><TextBlock x:Name="HotkeyDisplay" Text="F9" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/></Border>
                                    <Button x:Name="SettingsHotkeyButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Capturar tecla" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="16,7" Click="CaptureKey_Click"/>
                                </Grid>
                                <Border x:Name="CaptureHintBorder" Visibility="Collapsed" Margin="0,10,0,0" Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource FocusRingBrush}" BorderThickness="1" CornerRadius="8" Padding="10,7" SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock x:Name="SettingsCaptureHint" Text="Pressione a tecla desejada (ou Esc para cancelar)" Foreground="{DynamicResource AccentBrush}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/></StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="&#xE720;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Microfone" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Escolha qual microfone o Vox vai ouvir" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/></StackPanel>
                                </StackPanel>
                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <ComboBox x:Name="MicrophoneCombo" VerticalContentAlignment="Center" MinHeight="38" SelectionChanged="Microphone_SelectionChanged"/>
                                    <Button x:Name="RefreshMicrophonesButton" Grid.Column="1" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Padding="13,7" Click="RefreshMicrophones_Click" ToolTip="Atualizar lista"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="Atualizar" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                                </Grid>
                                <TextBlock Text="Use “Padrão do Windows” para seguir o microfone padrão do sistema. Útil quando você tem um mic virtual como o AudioRelay." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.9" LineHeight="17"/>
                                <Button Style="{StaticResource GhostButton}" Margin="0,14,0,0" HorizontalAlignment="Left" Padding="13,7" Click="TestVoice_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F2;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Testar voz de resposta" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True"><TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="Aparência" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Tema do aplicativo" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,1,0,0"/></StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <RadioButton x:Name="ThemeDark" Style="{StaticResource TypePill}" Content="Escuro"/>
                                    <RadioButton x:Name="ThemeLight" Style="{StaticResource TypePill}" Content="Claro"/>
                                    <RadioButton x:Name="ThemeSystem" Style="{StaticResource TypePill}" Content="Sistema" IsChecked="True"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="StatusBorder" Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,2,0,0" Visibility="Collapsed" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/><TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/></StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <TextBlock Text="As alterações são aplicadas ao salvar" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" Opacity="0.9"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource GhostButton}" Content="Cancelar" Padding="16,8" Click="SettingsCancel_Click"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Salvar" Margin="10,0,0,0" Padding="22,8" Click="SaveSettings_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- VIEW: Histórico — editorial -->
                <Grid x:Name="HistoryViewRoot" Visibility="Collapsed" Margin="32,20,32,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Style="{StaticResource GhostButton}" Padding="10,6" Click="BackToList_Click">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center"/><TextBlock Text="Voltar" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </Button>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Histórico" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextOptions.TextFormattingMode="Ideal"/>
                            <TextBlock Text="Últimos 20 comandos executados" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12.5" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" ItemContainerStyle="{StaticResource ListCardItem}"/>
                    <StackPanel x:Name="EmptyHistory" Grid.Row="1" HorizontalAlignment="Center" Margin="0,48,0,0">
                        <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Nenhum comando ainda" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                        <TextBlock Text="Seus comandos por voz aparecerão aqui." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Overlay: App Picker — overlay tinted, shadow subtle -->
                <Border x:Name="AppPickerOverlay" Visibility="Collapsed" Background="#66000000" CornerRadius="0">
                    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Width="560" MaxHeight="520" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.18" Color="#000000"/></Border.Effect>
                        <Grid Margin="18">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <TextBlock Text="Escolher aplicativo instalado" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Button Style="{StaticResource GhostButton}" Padding="8,4" HorizontalAlignment="Right" Content="✕" Click="CloseAppPicker_Click"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,14,0,0">
                                <local:WatermarkTextBox x:Name="AppSearchBox" Placeholder="Buscar aplicativo..." TextChanged="AppSearch_TextChanged"/>
                            </Grid>
                            <TextBlock x:Name="AppPickerStatus" Grid.Row="2" Text="Carregando..." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="2,8,0,0"/>
                            <ListBox x:Name="AppListBox" Grid.Row="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource PickerItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonDown="AppList_PreviewMouseLeftButtonDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <local:AppIconControl Icon="{Binding Icon}" HasIcon="{Binding HasIcon}" AvatarChar="{Binding AvatarChar}" Category="app" Size="24" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                <Button Style="{StaticResource GhostButton}" Content="Cancelar" Click="CloseAppPicker_Click"/>
                                <Button Style="{StaticResource PrimaryButton}" Content="Escolher" Margin="10,0,0,0" Click="ChooseApp_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                <!-- Overlay: Editar atalho — tinted -->
                <Border x:Name="EditHotkeyOverlay" Visibility="Collapsed" Background="#66000000">
                    <Border Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0" SnapsToDevicePixels="True">
                        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.18" Color="#000000"/></Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="12,12,0,0">
                                <Grid><TextBlock Text="Definir atalho" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/><Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="CloseHotkeyOverlay_Click"/></Grid>
                            </Border>
                            <Grid Grid.Row="1" Margin="24,18,24,12">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock x:Name="EditCommandLabel" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Row="1" Margin="0,16,0,0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24,26">
                                    <Grid>
                                        <ItemsControl x:Name="EditKeycapDisplay" HorizontalAlignment="Center">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource KeycapLarge}"><TextBlock Text="{Binding}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/></Border></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock x:Name="EditPressHint" Text="Pressione a combinação..." Foreground="{DynamicResource TextSecondaryBrush}" FontStyle="Italic" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock x:Name="EditHintText" Grid.Row="2" Text="Dica: Ctrl, Alt, Shift ou Win + tecla  (ex.: Alt+V)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,12,0,0"/>
                            </Grid>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="24,0,24,18">
                                <Button Style="{StaticResource GhostButton}" Content="Cancelar" Click="CloseHotkeyOverlay_Click"/>
                                <Button x:Name="SaveHotkeyButton" Style="{StaticResource PrimaryButton}" Content="Salvar" Margin="10,0,0,0" IsEnabled="False" Click="SaveHotkey_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>
            </Grid>

            <!-- ===== Rodapé — editorial, mic hero ===== -->
            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,14" SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="MicButton" Style="{StaticResource MicButton}" Content="&#xE720;" ToolTip="Segure para falar" PreviewMouseLeftButtonDown="MicButton_MouseLeftButtonDown" PreviewMouseLeftButtonUp="MicButton_MouseLeftButtonUp" LostMouseCapture="MicButton_LostMouseCapture">
                        <Button.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Button.RenderTransform>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Comando por voz" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="VoiceStatusText" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="620" HorizontalAlignment="Left"/>
                        <Button x:Name="EnableSpeechButton" Style="{StaticResource GhostButton}" Content="Abrir configurações de fala" FontSize="11" Padding="10,4" Margin="0,6,0,0" HorizontalAlignment="Left" Visibility="Collapsed" Click="EnableSpeech_Click"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.9">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="20" Padding="10,5" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <TextBlock x:Name="FooterHint" Text="Segure • fale • solte" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
