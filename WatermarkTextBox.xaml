<UserControl x:Class="Vox.WatermarkTextBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <TextBox x:Name="Box" Style="{StaticResource TextField}" TextChanged="Box_TextChanged"/>
        <TextBlock x:Name="WatermarkText"
                   Text="{Binding Placeholder, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5"
                   Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
</UserControl>
