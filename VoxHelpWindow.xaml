<Window x:Class="Vox.VoxHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Histórico"
        Icon="Vox.ico"
        Width="560" Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="16">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}">
                <Grid>
                    <TextBlock Text="Histórico" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="28,20,28,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="Histórico" FontSize="16.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Últimos 20 comandos executados" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14.5" Margin="0,2,0,0"/>
                </StackPanel>
                <ListBox x:Name="HistoryList" Grid.Row="1" Margin="0,10,0,0"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         FontSize="15.5" Foreground="{DynamicResource TextPrimaryBrush}"
                         ItemContainerStyle="{StaticResource ListCardItem}"/>
                <TextBlock x:Name="EmptyHistory" Grid.Row="1" Text="Nenhum comando executado ainda"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" Margin="0,24,0,0"
                           HorizontalAlignment="Center"/>
            </Grid>

            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                <TextBlock Text="Histórico dos últimos comandos executados" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14.5" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>