<Window x:Class="VoxSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instalar Vox"
        Height="620" Width="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#0D0F13"
        WindowStyle="SingleBorderWindow"
        Icon="Vox.ico">

    <Window.Resources>
        <!-- Paleta editorial dark -->
        <SolidColorBrush x:Key="Bg" Color="#0D0F13"/>
        <SolidColorBrush x:Key="Card" Color="#171A1E"/>
        <SolidColorBrush x:Key="CardBorder" Color="#262A30"/>
        <SolidColorBrush x:Key="Muted" Color="#A0A6B0"/>
        <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Subtext" Color="#CCCCD6"/>
        <SolidColorBrush x:Key="Accent" Color="#6C5CE7"/>
        <SolidColorBrush x:Key="AccentHover" Color="#7B6EF0"/>
        <SolidColorBrush x:Key="Success" Color="#00D68F"/>
        <SolidColorBrush x:Key="InputBg" Color="#1E2127"/>
        <SolidColorBrush x:Key="InputBorder" Color="#2E333E"/>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="#1E2127"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2E333E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#262B34"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1A1E25"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="#6C5CE7"/>
            <Setter Property="BorderBrush" Value="#6C5CE7"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#7B6EF0"/>
                                <Setter Property="BorderBrush" Value="#7B6EF0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#5B4BD6"/>
                                <Setter Property="BorderBrush" Value="#5B4BD6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Conteúdo principal -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header editorial -->
            <Border Grid.Row="0" Background="#0D0F13" Padding="28,28,28,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14" Background="#171A1E" BorderBrush="#262A30" BorderThickness="1" VerticalAlignment="Top">
                        <Image Source="Vox.png" Width="28" Height="28" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Text="Vox" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,2"/>
                        <TextBlock Text="assistente local · 100% offline · voz pt-BR" Foreground="#A0A6B0" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"/>
                        <Border Background="#171A1E" BorderBrush="#262A30" BorderThickness="1" CornerRadius="8" Padding="10,8">
                            <TextBlock Text="Launcher + voz local. Sem nuvem. Reconhecimento e síntese offline." Foreground="#CCCCD6" FontSize="12" TextWrapping="Wrap" LineHeight="16"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Conteudo -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,0,28,16">
                <StackPanel>
                    <TextBlock Text="ONDE INSTALAR" Foreground="#7A7F8A" FontSize="10" FontWeight="Bold" Margin="0,4,0,8"/>
                    <Border Background="#171A1E" BorderBrush="#262A30" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Pasta de instalação" Foreground="#A0A6B0" FontSize="11" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#1E2127" BorderBrush="#2E333E" BorderThickness="1" CornerRadius="8" Padding="10,7" Margin="0,0,8,0">
                                    <TextBox x:Name="PathBox" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="12" Text="%LOCALAPPDATA%\Vox" IsReadOnly="False" VerticalAlignment="Center"/>
                                </Border>
                                <Button Grid.Column="1" Content="Procurar" Style="{StaticResource GhostButton}" Padding="12,7" FontSize="12" Click="Browse_Click"/>
                            </Grid>
                            <TextBlock x:Name="SpaceCheck" Foreground="#A0A6B0" FontSize="11" Margin="0,8,0,0" Text="Espaço necessário: ~260 MB · Instalação para o usuário atual (sem admin)"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ATALHOS" Foreground="#7A7F8A" FontSize="10" FontWeight="Bold" Margin="0,18,0,8"/>
                    <Border Background="#171A1E" BorderBrush="#262A30" BorderThickness="1" CornerRadius="12" Padding="14">
                        <StackPanel>
                            <CheckBox x:Name="DesktopCheck" Content="Criar atalho na Área de Trabalho" IsChecked="False"/>
                            <CheckBox x:Name="AutostartCheck" Content="Iniciar com o Windows" IsChecked="True"/>
                            <CheckBox x:Name="StartMenuCheck" Content="Criar atalho no Menu Iniciar" IsChecked="True"/>
                            <TextBlock Text="Você pode fixar na Barra de Tarefas após instalar." Foreground="#7A7F8A" FontSize="11" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="StatusText" Text="Preparando..." Foreground="White" FontSize="12"/>
                            <TextBlock x:Name="PercentText" Text="0%" Foreground="#A0A6B0" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                        <Border Background="#1E2127" CornerRadius="999" Height="8" ClipToBounds="True">
                            <Border x:Name="ProgressFill" Background="#6C5CE7" CornerRadius="999" HorizontalAlignment="Left" Width="0" Height="8"/>
                        </Border>
                        <TextBlock x:Name="DetailText" Text="" Foreground="#7A7F8A" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border x:Name="ErrorPanel" Visibility="Collapsed" Background="#1A1214" BorderBrush="#3A1A1F" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                        <TextBlock x:Name="ErrorText" Text="" Foreground="#FF8A8A" FontSize="11" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#0D0F13" BorderBrush="#1A1E24" BorderThickness="0,1,0,0" Padding="28,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="v1.1.0 · Instalação para usuário atual" Foreground="#5A5F6A" FontSize="11" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Fechar" Style="{StaticResource GhostButton}" Width="88" Margin="0,0,8,0" Click="Close_Click"/>
                        <Button x:Name="InstallBtn" Content="Instalar" Style="{StaticResource PrimaryButton}" Width="120" Click="Install_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Overlay sucesso — editorial premium -->
        <Grid x:Name="SuccessOverlay" Visibility="Collapsed" Background="#CC0D0F13">
            <Border Width="400" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#171A1E" BorderBrush="#262A30" BorderThickness="1" CornerRadius="16"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.5" BlurRadius="24" ShadowDepth="8" Direction="270"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Top accent line -->
                    <Border Height="3" Background="#6C5CE7" CornerRadius="16,16,0,0" Margin="0,0,0,0"/>
                    <StackPanel Margin="28,24,28,24">
                        <!-- Icon + title -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="14" Background="#13261E" BorderBrush="#1E3D2A" BorderThickness="1">
                                <TextBlock Text="✓" Foreground="#00D68F" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,2"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,2,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Pronto!" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,2"/>
                                <TextBlock Text="Vox foi instalado com sucesso" Foreground="#A0A6B0" FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Path card -->
                        <Border Background="#1E2127" BorderBrush="#2E333E" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <TextBlock Text="LOCAL DE INSTALAÇÃO" Foreground="#7A7F8A" FontSize="10" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="SuccessPathText" Text="C:\Users\...\AppData\Local\Vox" Foreground="White" FontSize="12" TextWrapping="Wrap" FontFamily="Consolas"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Atalhos criados no Menu Iniciar" Foreground="#7A7F8A" FontSize="11" VerticalAlignment="Center"/>
                                    <Border Grid.Column="1" Background="#1A2B1E" CornerRadius="6" Padding="6,3">
                                        <TextBlock Text="● pronto" Foreground="#00D68F" FontSize="10" FontWeight="SemiBold"/>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Você pode fixar na Barra de Tarefas. O Vox inicia minimizado e aguarda sua voz." Foreground="#7A7F8A" FontSize="11" TextWrapping="Wrap" Margin="0,14,0,0" LineHeight="16"/>

                        <!-- Buttons -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Fechar" Style="{StaticResource GhostButton}" Margin="0,0,6,0" Padding="0,11" Click="SuccessClose_Click"/>
                            <Button Grid.Column="1" Content="Abrir Vox" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Padding="0,11" Click="SuccessOpen_Click"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
