<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- vox • Light — warm-paper leaning, not cold blue-gray. Single accent, editorial flat. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F7F6F3"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0EEEA"/>
    <SolidColorBrush x:Key="SurfaceMutedBrush" Color="#F5F3EF"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E8E6E0"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#D8D5CE"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#EDEBE6"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1E26"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280"/>
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9AA0AE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B4FCE"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6F64E0"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4E42C4"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EDEAFB"/>
    <SolidColorBrush x:Key="AccentGhostBrush" Color="#F4F2FF"/>
    <SolidColorBrush x:Key="FocusRingBrush" Color="#8B7CF7"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D6453D"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC5A52"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#B83A32"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDECEC"/>
    <SolidColorBrush x:Key="DangerGhostBrush" Color="#FFF5F5"/>
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="#E0DDD6"/>
    <SolidColorBrush x:Key="WidgetBgBrush" Color="#CCF7F6F3"/>
    <SolidColorBrush x:Key="IconFallbackBrush" Color="#EDEBE6"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#ECE9E3"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#EDEAFB"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#D1CCC2"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#B8B2A6"/>
    <SolidColorBrush x:Key="ShadowTintBrush" Color="#E8E4DE"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B4FCE" Offset="0"/>
        <GradientStop Color="#3B7BE0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SiteGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2F7CF6" Offset="0"/>
        <GradientStop Color="#0FA58F" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="KeycapBrush" Color="#FFFFFF"/>

</ResourceDictionary>
