<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BgBrush" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D8DEE8"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#B9C3D4"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B2430"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5A6A80"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#5B4FCE"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6F64E0"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D6453D"/>
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="#C6CFDC"/>
    <SolidColorBrush x:Key="WidgetBgBrush" Color="#CCF4F6FA"/>
    <SolidColorBrush x:Key="IconFallbackBrush" Color="#E2E8F2"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#E7ECF4"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#E3E9F3"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C2CBD9"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#AAB6C8"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B4FCE" Offset="0"/>
        <GradientStop Color="#3B7BE0" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SiteGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2F7CF6" Offset="0"/>
        <GradientStop Color="#0FA58F" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeycapBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E8EDF5" Offset="0"/>
        <GradientStop Color="#DDE4EF" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>