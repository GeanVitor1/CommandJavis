<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BgBrush" Color="#0D1117"/>
    <SolidColorBrush x:Key="TitleBarBrush" Color="#0F141D"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#161D29"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#1B2433"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#263142"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#34435A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E9EFF7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#93A1B4"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#6C5CE7"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8175F2"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5534B"/>
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="#3A4657"/>
    <SolidColorBrush x:Key="WidgetBgBrush" Color="#CC0D1117"/>
    <SolidColorBrush x:Key="IconFallbackBrush" Color="#1E2836"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#222B3A"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#22304A"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#2C394D"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#3A4A63"/>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6C5CE7" Offset="0"/>
        <GradientStop Color="#4C8DFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SiteGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3B82F6" Offset="0"/>
        <GradientStop Color="#14B8A6" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="KeycapBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#243044" Offset="0"/>
        <GradientStop Color="#1A2330" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>