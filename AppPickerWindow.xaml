<Window x:Class="Vox.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Vox"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Escolher aplicativo instalado"
        Icon="Vox.ico"
        Width="620" Height="560"
        MinWidth="520" MinHeight="420"
        WindowStyle="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Opacity="0.14" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Barra de título — editorial ===== -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="12,12,0,0" SnapsToDevicePixels="True">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Escolher aplicativo" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,0"/>
                    </StackPanel>
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>
            </Border>

            <!-- ===== Busca ===== -->
            <Grid Grid.Row="1" Margin="28,18,28,10">
                <local:WatermarkTextBox x:Name="SearchBox" Placeholder="Buscar aplicativo..." TextChanged="Search_TextChanged"/>
            </Grid>

            <!-- ===== Status — tertiary, editorial ===== -->
            <TextBlock x:Name="StatusText" Grid.Row="2" Text="Carregando aplicativos instalados..." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" Margin="30,0,0,8"/>

            <!-- ===== Lista ===== -->
            <ListBox x:Name="AppListBox"
                     Grid.Row="3"
                     Margin="28,0,28,14"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource PickerItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewMouseLeftButtonDown="AppList_PreviewMouseLeftButtonDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <local:AppIconControl Icon="{Binding Icon}" HasIcon="{Binding HasIcon}"
                                                  AvatarChar="{Binding AvatarChar}" Category="app"
                                                  Size="24" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ===== Botões ===== -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="28,0,28,22">
                <Button Style="{StaticResource GhostButton}" Content="Cancelar" Click="Cancel_Click"/>
                <Button Style="{StaticResource PrimaryButton}" Content="Escolher" Margin="10,0,0,0" Click="Choose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

