<Window x:Class="Vox.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirmar ação"
        Width="440" Height="220"
        WindowStyle="None"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.14" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource TitleBarBrush}" CornerRadius="12,12,0,0" SnapsToDevicePixels="True">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="Confirmar ação" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButton}" Content="&#xE8BB;" Click="Cancel_Click" ToolTip="Cancelar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="1" Margin="24,18,24,0">
                <TextBlock x:Name="MessageText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="20"/>
                <TextBlock Text="Esta ação será executada pelo comando de voz." Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" Margin="0,6,0,0"/>
                <Border Background="{DynamicResource AccentGhostBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,14,0,0" SnapsToDevicePixels="True">
                    <TextBlock x:Name="CountdownText" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="Medium" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>

            <Border Grid.Row="2" Background="{DynamicResource TitleBarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Cancelar" Click="Cancel_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Executar" Margin="10,0,0,0" Click="Confirm_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>